# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Snowflake (usuario de servicio creado por snowflake/setup.sql)
SNOWFLAKE_ACCOUNT=ORGANIZACION-CUENTA
SNOWFLAKE_USER=PSET2_SERVICE
SNOWFLAKE_PAT=pegar_aqui_el_token
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH

# Fuente de datos (Release publico con los datos sinteticos)
FUENTE_URL=https://github.com/stephania99c/pset2-pipeline-cartera/releases/download/datos-v1

# Usuario de la interfaz de Kestra
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=elegir_una_clave

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000